{
  "name": "recallguard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "RecallGuard - the freshness gate for AI-agent memory. A Walrus-backed memory is checked against current Sui state through Tatum Sui Mainnet GraphQL before an agent can act on it; stale or unverifiable memories are withheld. MCP-native.",
  "license": "Apache-2.0",
  "bin": {
    "recall_checked": "./scripts/recall-checked.mjs",
    "recallguard": "./scripts/recall-checked.mjs",
    "recallguard-mcp": "./scripts/recallguard-mcp.mjs"
  },
  "exports": {
    ".": "./src/recall-checked.mjs",
    "./core": "./src/answer.mjs"
  },
  "files": [
    "src/",
    "scripts/recall-checked.mjs",
    "scripts/recallguard-mcp.mjs",
    "docs/evidence/proof-snapshot.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "RUN_MAINNET=1 node --test test/live/*.test.mjs",
    "answer": "node scripts/answer.mjs",
    "recall:checked": "node scripts/recall-checked.mjs",
    "observe": "node scripts/observer.mjs",
    "proof": "node scripts/proof-page.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:offline": "node scripts/demo.mjs --offline",
    "proof:live": "node scripts/proof-page.mjs --live --port=8787",
    "proof:offline": "node scripts/proof-page.mjs --offline --port=8787",
    "measure": "node scripts/measure-claim-classes.mjs",
    "credits": "node scripts/measure-credits.mjs",
    "prewarm": "node scripts/prewarm.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "freeze": "node scripts/freeze.mjs",
    "export": "node scripts/export-site.mjs",
    "mcp": "node scripts/recallguard-mcp.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mysten-incubation/memwal": "0.1.13",
    "@mysten/seal": "1.1.3",
    "@mysten/sui": "2.16.2",
    "@mysten/walrus": "1.1.7",
    "zod": "3.25.76"
  },
  "keywords": [
    "walrus",
    "sui",
    "tatum",
    "mcp",
    "ai-agents",
    "agent-memory",
    "freshness",
    "verification",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unifyWeb3/recallguard.git"
  },
  "homepage": "https://recallguard-oxunify.vercel.app",
  "bugs": "https://github.com/unifyWeb3/recallguard/issues"
}
